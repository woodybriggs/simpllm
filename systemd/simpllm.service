[Unit]
Description=simpllm - local AI model request proxy
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/simpllm
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t /tmp

# Environment
Environment=HOME=%h

[Install]
WantedBy=default.target
